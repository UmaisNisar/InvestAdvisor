@* Host document for the Blazor Web App (interactive Server) model. Replaces the
   legacy Pages/_Host.cshtml + blazor.server.js setup, which .NET 10 no longer serves.
   The whole shared Root (MudBlazor providers + Router + theme) is rendered interactively. *@
@inject InvestAdvisor.Core.Abstractions.IRuntimeSettingsStore SettingsStore
<!DOCTYPE html>
<html lang="en" class="@_themeClass">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>InvestAdvisor</title>
    <base href="/" />
    @* @Assets fingerprints the URLs, so icon changes bust browser/CDN caches automatically
       (favicons are cached notoriously hard otherwise). *@
    <link rel="icon" type="image/svg+xml" href="@Assets["_content/InvestAdvisor.Ui/favicon.svg"]" />

    @* Installable PWA: launches full-screen from the home screen (no browser chrome). *@
    <link rel="manifest" href="@Assets["_content/InvestAdvisor.Ui/manifest.webmanifest"]" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="InvestAdvisor" />
    <link rel="apple-touch-icon" sizes="180x180" href="@Assets["_content/InvestAdvisor.Ui/apple-touch-icon.png"]" />
    <meta name="theme-color" content="#F2F2F7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <link href="@Assets["_content/InvestAdvisor.Ui/css/app.css"]" rel="stylesheet" />

    @* Belt-and-braces splash tint: the html class is normally stamped server-side from the
       settings DB (see @code below) so even the very first visit matches the saved theme; the
       localStorage mirror written by Root only fills in if that DB read failed. With neither,
       the splash falls back to prefers-color-scheme. *@
    <script>
        try {
            var iaCls = document.documentElement.classList;
            if (!iaCls.contains('ia-theme-light') && !iaCls.contains('ia-theme-dark')) {
                var iaTheme = localStorage.getItem('ia-theme');
                if (iaTheme === 'light' || iaTheme === 'dark') iaCls.add('ia-theme-' + iaTheme);
            }
        } catch (e) { /* storage blocked; OS-scheme fallback applies */ }
    </script>
    <HeadOutlet @rendermode="@(new InteractiveServerRenderMode(prerender: false))" />
</head>
<body>
    @* Boot splash: visible immediately as static HTML and removed once the interactive circuit
       connects (Root calls iaSplash.hide on first render). Without prerendering the app area is
       blank until the circuit is up, so this gives instant "something is loading" feedback. *@
    <div id="ia-splash">
        <div class="ia-splash-spinner"></div>
        <div class="ia-splash-text">Loading InvestAdvisor…</div>
    </div>

    <InvestAdvisor.Ui.Root @rendermode="@(new InteractiveServerRenderMode(prerender: false))" />

    <div id="blazor-error-ui">
        An unhandled error has occurred.
        <a href="" class="reload">Reload</a>
        <a class="dismiss">🗙</a>
    </div>

    @* Custom, readable reconnect overlay (the framework default renders white-on-white). *@
    <div id="components-reconnect-modal">
        <div class="reconnect-box">
            <div class="reconnect-spinner"></div>
            <div>
                <div class="reconnect-title">Reconnecting to the server…</div>
                <div class="reconnect-sub">If this doesn't clear, <a href="" class="reload">reload the page</a>.</div>
            </div>
        </div>
    </div>

    <script src="@Assets["_content/InvestAdvisor.Ui/js/ia-interop.js"]"></script>
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
</body>
</html>

@code {
    private string _themeClass = "";

    protected override async Task OnInitializedAsync()
    {
        // This host page is rendered server-side per request, so it can stamp the saved theme
        // onto <html> directly from the settings DB — the boot splash is then correctly tinted
        // on the very first paint, fresh browsers and first-ever visits included. The store is
        // an in-memory-cached singleton row, so this is not a per-request DB hit in practice.
        try { _themeClass = (await SettingsStore.GetAsync()).DarkMode ? "ia-theme-dark" : "ia-theme-light"; }
        catch { /* leave unset: the localStorage mirror or the OS scheme takes over */ }
    }
}
