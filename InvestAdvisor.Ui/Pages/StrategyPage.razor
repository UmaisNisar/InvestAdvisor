@page "/swing"
@page "/momentum"
@using InvestAdvisor.Core.Trading
@inject IStrategyQueries Queries
@inject IRunManager Runs
@inject ITenantContext Tenant
@inject IRuntimeSettingsStore Settings
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@implements IDisposable

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-1" Style="flex-wrap:wrap">
    <MudTooltip Text="@P.TitleTooltip">
        <MudText Typo="Typo.h4">@P.Title</MudText>
    </MudTooltip>
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Style="flex-wrap:wrap">
        <MudTooltip Text="@P.RiskTooltip">
            <MudSelect T="RiskLevel" Value="_risk" ValueChanged="OnRiskChanged" Label="Risk" Dense="true"
                       Variant="Variant.Outlined" Disabled="_running" Style="min-width:120px">
                <MudSelectItem Value="RiskLevel.Low">Low</MudSelectItem>
                <MudSelectItem Value="RiskLevel.Medium">Medium</MudSelectItem>
                <MudSelectItem Value="RiskLevel.High">High</MudSelectItem>
            </MudSelect>
        </MudTooltip>
        <MudTooltip Text="@P.RescanTooltip">
            <MudButton StartIcon="@Icons.Material.Filled.PlayArrow" Color="Color.Primary" Variant="Variant.Filled"
                       OnClick="RunNow" Disabled="_running" Style="white-space:nowrap">
                @(_running ? "Scanning…" : "Re-scan now")
            </MudButton>
        </MudTooltip>
        <MudButton Href="@P.CrossLink.Href" Variant="Variant.Text" Color="Color.Primary" StartIcon="@P.CrossLink.Icon" Style="white-space:nowrap">@P.CrossLink.Label</MudButton>
    </MudStack>
</MudStack>

@if (!_loaded)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else
{
    @* The honest gate: setups are paper-only until the backtest shows a measured edge. *@
    @if (_data!.Validated)
    {
        <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Dense="true" Class="mb-3">
            Backtest shows a positive edge on @_data.Backtest!.TotalTrades historical trades (profit factor @_data.Backtest.ProfitFactor.ToString("0.00")). @P.ValidatedNote
        </MudAlert>
    }
    else
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-3">
            <b>Paper only — not yet validated.</b> @P.PaperOnlyNote
        </MudAlert>
    }

    <MudText Typo="Typo.caption" Color="Color.Surface" Class="mb-3">
        @if (_data.SetupsGeneratedAtUtc is { } d)
        {
            @($"Generated {d:MMM d} · universe of {_data.UniverseSize} {P.UniverseNoun} · refreshes daily")
        }
        else
        {
            @($"Universe of {_data.UniverseSize} {P.UniverseNoun} · the scanner produces setups once a day — check back shortly")
        }
    </MudText>

    <MudGrid>
        <MudItem xs="12" md="7">
            <MudText Typo="Typo.h6" GutterBottom="true">@P.SetupsHeading</MudText>
            @if (_data.Setups.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                    No qualifying setups at <b>@_risk</b> risk right now — @P.NoSetupsNote
                </MudAlert>
            }
            else
            {
                @foreach (var s in _data.Setups)
                {
                    <SetupCard Setup="s" Strategy="P.Kind" />
                }
            }
        </MudItem>

        <MudItem xs="12" md="5">
            <MudText Typo="Typo.h6" GutterBottom="true">Track record</MudText>
            <MudPaper Class="pa-4 mb-4" Elevation="1">
                @if (_data.TrackRecord is { } tr)
                {
                    <MudText Typo="Typo.caption" Color="Color.Surface">Out-of-sample, from logged paper trades.</MudText>
                    <MudSimpleTable Dense="true" Hover="false" Class="mt-2" Style="background:transparent">
                        <tbody>
                            <tr><td>Resolved</td><td align="right">@tr.Resolved</td></tr>
                            <tr><td>Open</td><td align="right">@tr.Open</td></tr>
                            <tr><td>Win rate</td><td align="right">@tr.WinRatePct.ToString("0.0")%</td></tr>
                            <tr><td>Total result</td><td align="right">@tr.TotalR.ToString("+0.0;-0.0;0.0")R</td></tr>
                            <tr><td>Avg per trade</td><td align="right">@tr.AverageR.ToString("+0.000;-0.000;0.000")R</td></tr>
                        </tbody>
                    </MudSimpleTable>
                    <MudText Typo="Typo.caption" Color="Color.Surface" Class="mt-2">R = multiples of the per-trade risk (distance to stop).</MudText>
                }
                else
                {
                    <MudText Typo="Typo.caption" Color="Color.Surface">No paper trades logged yet — accruing as the scanner runs.</MudText>
                }
            </MudPaper>

            <MudText Typo="Typo.h6" GutterBottom="true">Backtest</MudText>
            <BacktestPanel Backtest="_data.Backtest" Caveat="@P.BacktestCaveat" />
        </MudItem>
    </MudGrid>

    @if (_data.Watchlist.Count > 0)
    {
        <MudText Typo="Typo.h6" Class="mt-5" GutterBottom="true">Watchlist — closest to triggering</MudText>
        <MudText Typo="Typo.caption" Color="Color.Surface" Class="mb-2">
            In a confirmed up-trend but not yet oversold enough to buy. These would fire on a further dip — watch them.
        </MudText>
        <MudPaper Elevation="1" Class="pa-1">
            <MudSimpleTable Dense="true" Hover="true" Style="background:transparent">
                <thead>
                    <tr><th>Ticker</th><th style="text-align:right">Price</th><th style="text-align:right">RSI</th><th style="text-align:right">vs 200-MA</th><th>What it needs</th></tr>
                </thead>
                <tbody>
                    @foreach (var w in _data.Watchlist)
                    {
                        <tr>
                            <td><code>@w.Ticker</code> <MudText Typo="Typo.caption" Inline="true" Color="Color.Surface">@w.Name</MudText></td>
                            <td style="text-align:right">@Fmt.Price(w.Close)</td>
                            <td style="text-align:right">@(w.Rsi?.ToString("0") ?? "—")</td>
                            <td style="text-align:right">@((w.RegimeDistancePct * 100m)?.ToString("+0.0;-0.0") ?? "—")%</td>
                            <td><MudText Typo="Typo.caption" Color="Color.Surface">@w.Note</MudText></td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </MudPaper>
    }

    <MudAlert Severity="Severity.Normal" Variant="Variant.Outlined" Dense="true" Class="mt-4">
        Educational research only, not financial advice. No broker is connected — you place any trade yourself.
        @P.Disclaimer
    </MudAlert>
}

@code {
    private StrategyPresentation P = StrategyPresentation.Swing;
    private StrategyDashboard? _data;
    private bool _loaded;
    // The scan runs in the singleton IRunManager so it survives navigation; this mirrors its state.
    private int _tid = -1;
    private ActiveRun? _run;
    private bool _running => _run is not null;
    private RiskLevel _risk = RiskLevel.Medium;

    protected override async Task OnInitializedAsync()
    {
        Runs.RunStateChanged += OnRunStateChanged;
        Nav.LocationChanged += OnLocationChanged;
        await LoadForCurrentRouteAsync();
    }

    // Both routes map to this one component, so switching between /swing and /momentum keeps the
    // instance alive — reload the dashboard for the new strategy rather than relying on re-init.
    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        var next = StrategyPresentation.ForRoute(new Uri(e.Location).AbsolutePath);
        if (next.Kind == P.Kind) return;
        await InvokeAsync(async () => { await LoadForCurrentRouteAsync(); StateHasChanged(); });
    }

    private async Task LoadForCurrentRouteAsync()
    {
        P = StrategyPresentation.ForRoute(new Uri(Nav.Uri).AbsolutePath);
        _loaded = false;
        try { _tid = await Tenant.GetTenantIdAsync(); _run = Runs.GetActive(_tid, P.RunKind); }
        catch { /* no authenticated user */ }
        try
        {
            _data = await Queries.GetDashboardAsync(P.Kind);
            _risk = _data.RiskLevel;
        }
        finally { _loaded = true; }
    }

    private async Task OnRiskChanged(RiskLevel level)
    {
        if (level == _risk || _running) return;
        _risk = level;
        var kind = P.Kind;
        await Settings.UpdateAsync(s => { if (kind == StrategyKind.Swing) s.SwingRiskLevel = level; else s.MomentumRiskLevel = level; });
        Snackbar.Add($"Risk set to {level} — re-scanning…", Severity.Info);
        RunNow();
    }

    private void RunNow()
    {
        if (_tid < 0) return;
        if (!Runs.Start(_tid, P.RunKind))
            Snackbar.Add("A scan is already in progress.", Severity.Info);
        // Progress + completion are driven by IRunManager.RunStateChanged.
    }

    // Fired by IRunManager on every phase change / start / finish for this tenant's scan.
    private async void OnRunStateChanged(object? sender, RunStateChangedEvent e)
    {
        if (e.TenantId != _tid || e.Kind != P.RunKind) return;
        _run = e.Active;
        if (e.Active is null) // scan ended — refresh today's setups
        {
            try { _data = await Queries.GetDashboardAsync(P.Kind); _risk = _data.RiskLevel; } catch { /* leave last view */ }
        }
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Runs.RunStateChanged -= OnRunStateChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
